# logrotate for Dionaea's logs. Install to /etc/logrotate.d/dionaea on the VPS.
#
# copytruncate is needed: Dionaea keeps the files open and won't reopen them on a signal, so we
# copy and truncate in place (rename + create would leave Dionaea writing to the old inode). Filebeat
# re-ingestion is idempotent (document_id = fingerprint), so a re-read after the truncate doesn't
# create duplicates in Elasticsearch.

/var/lib/docker/volumes/honeypots_dionaea_var/_data/log/dionaea/*.log
/var/lib/docker/volumes/honeypots_dionaea_var/_data/lib/dionaea/dionaea.json
{
    daily
    rotate 7
    size 100M
    missingok
    notifempty
    compress
    delaycompress
    copytruncate
}
