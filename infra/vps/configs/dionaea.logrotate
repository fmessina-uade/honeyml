# logrotate para los registros de Dionaea. Se instala en /etc/logrotate.d/dionaea del servidor.
#
# Va con copytruncate porque Dionaea mantiene los archivos abiertos y no los reabre ante una señal:
# hay que copiar y truncar en el lugar, ya que renombrar y crear dejaría a Dionaea escribiendo en el
# inodo viejo. Que Filebeat vuelva a leer después del truncado no duplica nada en Elasticsearch,
# porque el identificador de cada documento es su huella.

/var/lib/docker/volumes/honeypots_dionaea_var/_data/log/dionaea/*.log
/var/lib/docker/volumes/honeypots_dionaea_var/_data/lib/dionaea/dionaea.json
{
    daily
    rotate 7
    size 100M
    missingok
    notifempty
    compress
    delaycompress
    copytruncate
}
