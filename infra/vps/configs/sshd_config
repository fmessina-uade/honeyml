# sshd_config endurecido del VPS de HoneyML
# Se aplica con 01_hardening.sh, o a mano: cp sshd_config /etc/ssh/sshd_config && systemctl restart ssh
# Verificar la sintaxis antes con: sshd -t

# Puerto no estándar: el 22 es de Cowrie, y así el ruido de bots no llega a la administración
Port 2200

Protocol 2

# Solo IPv4, IPv6 deshabilitado en sysctl
AddressFamily inet

# Autenticación solo por clave pública
PermitRootLogin no
PasswordAuthentication no
ChallengeResponseAuthentication no
PubkeyAuthentication yes
AuthorizedKeysFile .ssh/authorized_keys

KerberosAuthentication no
GSSAPIAuthentication no
UsePAM yes

LoginGraceTime 30
MaxAuthTries 3
MaxSessions 5

# Solo el usuario administrador del proyecto
AllowUsers honeyml

# Sin reenvío de puertos ni túneles, salvo la excepción del final. Tampoco se reenvía el agente SSH:
# con el agente de la estación disponible en el servidor, quien tuviera el control del servidor
# podría usar esa clave para entrar a otros lados mientras dura la sesión.
AllowTcpForwarding no
AllowAgentForwarding no
AllowStreamLocalForwarding no
GatewayPorts no
X11Forwarding no
PermitTunnel no
PermitUserEnvironment no

# Keepalive a nivel de aplicación y no de TCP, para evitar falsos positivos
ClientAliveInterval 300
ClientAliveCountMax 2
TCPKeepAlive no

SyslogFacility AUTH
LogLevel VERBOSE

# Solo algoritmos modernos
KexAlgorithms curve25519-sha256,curve25519-sha256@libssh.org,diffie-hellman-group14-sha256,diffie-hellman-group16-sha512
Ciphers chacha20-poly1305@openssh.com,aes256-gcm@openssh.com,aes128-gcm@openssh.com
MACs hmac-sha2-512-etm@openssh.com,hmac-sha2-256-etm@openssh.com,hmac-sha2-512,hmac-sha2-256

PrintMotd no
PrintLastLog yes
Banner /etc/ssh/banner_honeyml
AcceptEnv LANG LC_*

# SFTP deshabilitado
# Subsystem sftp /usr/lib/openssh/sftp-server

# La excepción: el túnel con que la estación de administración alcanza la API, que escucha solo en
# loopback. Reenvío local (-L, nunca -R), solo para el usuario del proyecto y solo hacia ese puerto.
# Ese usuario ya tiene sudo, así que el túnel no le abre nada que no tuviera.
# Un bloque Match vale hasta el final del archivo: tiene que quedar último.
Match User honeyml
    AllowTcpForwarding local
    PermitOpen 127.0.0.1:8000
