# Bus de eventos en tiempo real, sobre los streams de Valkey.
# Se copia a infra/valkey/.env y se ajusta si hace falta.

# Tope de memoria del proceso. Con noeviction, alcanzarlo hace fallar la escritura en lugar de
# descartar eventos en silencio.
BUS_MAXMEMORY=512mb

# Límite del contenedor. Deja margen sobre BUS_MAXMEMORY para el propio proceso.
BUS_MEM_LIMIT=768m
