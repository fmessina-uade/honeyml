# Bus de eventos en tiempo real (Redis Streams).
# Copiar a infra/redis/.env y ajustar si hace falta.

# Tope de memoria del proceso. Con noeviction, alcanzarlo hace fallar la escritura
# en lugar de descartar eventos en silencio.
REDIS_MAXMEMORY=512mb

# Límite del contenedor. Deja margen sobre REDIS_MAXMEMORY para el propio proceso.
REDIS_MEM_LIMIT=768m
