# Configuración del stack de Elastic. Se copia a `.env` y se ajusta en cada entorno; el `.env` real
# no se versiona.

# Elasticsearch, Logstash y Filebeat comparten la etiqueta de versión.
ELASTIC_VERSION=8.17.3

# Memoria, pensada para un servidor de 16 GB que comparte con Cowrie (512m) y Dionaea (1g). El heap
# de Elasticsearch va con mínimo y máximo iguales, y no pasa de la mitad de la memoria del
# contenedor.
ES_HEAP=1g
ES_MEM_LIMIT=2g

LS_HEAP=512m
LS_MEM_LIMIT=1536m

FB_MEM_LIMIT=256m

# Clave del bus, con la que Logstash publica. Vacía quiere decir sin autenticación; en el servidor
# tiene que tener valor, el mismo que en infra/valkey/.env y en el .env de la raíz.
BUS_PASSWORD=
