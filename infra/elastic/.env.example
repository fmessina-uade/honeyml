# HoneyML Elastic Stack config.
# Copy to `.env` and tweak per environment. The real `.env` is gitignored.

# stack version (Elasticsearch, Logstash, Kibana, Filebeat share the tag)
ELASTIC_VERSION=8.17.3

# memory tuning (16GB VPS, shared with Cowrie 512m + Dionaea 1g)
# Elasticsearch JVM heap (Xms=Xmx). Rule of thumb: <= 50% of the container RAM.
ES_HEAP=1g
ES_MEM_LIMIT=2g

# Logstash heap
LS_HEAP=512m
LS_MEM_LIMIT=1g

# Kibana limit
KB_MEM_LIMIT=1g

# Filebeat limit
FB_MEM_LIMIT=256m
