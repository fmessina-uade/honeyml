# Configuración del Elastic Stack de HoneyML.
# Copiar a `.env` y ajustar según el entorno.  El `.env` real está en .gitignore.

# Versión del stack (Elasticsearch, Logstash, Kibana, Filebeat comparten tag)
ELASTIC_VERSION=8.17.3

# --- Tuning de memoria (VPS 16GB, conviven con Cowrie 512m + Dionaea 1g) ---
# Heap de la JVM de Elasticsearch (Xms=Xmx). Regla: <= 50% de la RAM del contenedor.
ES_HEAP=1g
ES_MEM_LIMIT=2g

# Heap de Logstash
LS_HEAP=512m
LS_MEM_LIMIT=1g

# Límite de Kibana
KB_MEM_LIMIT=1g

# Límite de Filebeat
FB_MEM_LIMIT=256m
