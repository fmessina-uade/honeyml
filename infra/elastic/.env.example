# Configuración del stack de Elastic. Se copia a `.env` y se ajusta en cada entorno; el `.env` real
# no se versiona.

# Elasticsearch, Logstash y Filebeat comparten la etiqueta de versión.
ELASTIC_VERSION=8.17.3

# Memoria. Estos valores alcanzan para levantar el stack en una máquina local. En el servidor de
# 16 GB, que además corre los sensores, el motor y la API, van ES_HEAP=2g, ES_MEM_LIMIT=4g,
# LS_HEAP=1g y LS_MEM_LIMIT=2g: con menos, el índice corta consultas por memoria y el normalizador
# queda al borde de su tope. El heap de Elasticsearch va con mínimo y máximo iguales, y no pasa de la
# mitad de la memoria del contenedor.
ES_HEAP=1g
ES_MEM_LIMIT=2g

LS_HEAP=512m
LS_MEM_LIMIT=1536m

FB_MEM_LIMIT=256m

# Clave del bus, con la que Logstash publica. Vacía quiere decir sin autenticación; en el servidor
# tiene que tener valor, el mismo que en infra/valkey/.env y en el .env de la raíz.
BUS_PASSWORD=
