# Plantilla de variables de entorno. Copiar a `.env` y completar:
#
#     cp .env.example .env
#
# --- Proveedor de inferencia ---

# Obligatoria. Se obtiene en https://console.groq.com
GROQ_API_KEY=

#
# El modelo se elige por adherencia garantizada al esquema, no por precio: Groq implementa el modo
# estricto con decodificación restringida solo en algunos modelos, y este es el de producción.
# La alternativa declarada para tandas masivas es openai/gpt-oss-20b.
#HONEYML_MODELO=openai/gpt-oss-120b
#HONEYML_INFERENCIA_URL=https://api.groq.com/openai/v1
#HONEYML_INFERENCIA_TIMEOUT=60
