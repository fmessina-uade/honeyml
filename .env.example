# Plantilla de variables de entorno. Copiar a `.env` y completar:
#
#     cp .env.example .env

# La clave del proveedor de inferencia es obligatoria y nunca va en un archivo del repositorio.
HONEYML_INFERENCIA_CLAVE=

# Dirección compatible con OpenAI. Sin definirla se usa Groq directo, que también acepta la clave en
# GROQ_API_KEY. Con OpenRouter, la dirección es la de abajo.
#HONEYML_INFERENCIA_URL=https://openrouter.ai/api/v1

# Solo con un enrutador: a qué proveedores puede ir el pedido, en orden y sin salirse de la lista.
# Sin esto elige el enrutador, siempre entre los que aceptan el esquema estricto y no guardan los
# pedidos.
#HONEYML_INFERENCIA_PROVEEDORES=groq,cerebras

# Sin definirlo decide la política: el modelo económico primero y el capaz al reintentar.
# Definirlo, con cualquier valor, fija ese modelo en todos los intentos.
#HONEYML_MODELO=openai/gpt-oss-120b
#HONEYML_INFERENCIA_TIMEOUT=60

# Clave del bus, para el motor y la API. Vacía quiere decir sin autenticación; en el servidor tiene
# que tener valor, el mismo que en infra/valkey/.env y en infra/elastic/.env.
BUS_PASSWORD=
